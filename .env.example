# Firebase（Firebaseコンソール > プロジェクト設定 > マイアプリ から取得）
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# FCM VAPID Key（Firebaseコンソール > プロジェクト設定 > Cloud Messaging > ウェブプッシュ証明書 から取得）
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# アプリID（任意の文字列、Firestoreのパスに使用）
VITE_APP_ID=lifequest

# Firebase Admin（サービスアカウントキー > Vercelの環境変数に設定）
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Cron認証用シークレット（任意のランダム文字列）
CRON_SECRET=your_random_secret_here
